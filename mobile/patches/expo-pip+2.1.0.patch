+    private val lifecycleObserver = object : DefaultLifecycleObserver {
+        override fun onPause(owner: LifecycleOwner) {
+            if (inPip || isInPipMode()) keepReactNativeDrawing()
+        }
+
+        override fun onStop(owner: LifecycleOwner) {
+            val closedWindow = inPip || SystemClock.uptimeMillis() - leftPipAt < 2000
+            if (!closedWindow) return
+            inPip = false
+            leftPipAt = 0L
+            this@ExpoPipModule.sendEvent("onPipClosed", bundleOf("closed" to true))
+            mainHandler.postDelayed({
+                val activity = observedActivity
+                val resumed = activity?.lifecycle?.currentState?.isAtLeast(Lifecycle.State.RESUMED) == true
+                if (!resumed) (appContext.reactContext as? ReactContext)?.onHostPause()
+            }, 500)
+        }
+    }
