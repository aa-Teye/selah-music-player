{
  "expo": {
    "name": "Selah",
    "slug": "selah-music-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08090C",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.selah.musicplayer",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.selah.musicplayer",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#08090C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Selah Player to access your music and audio files.",
          "savePhotosPermission": "Allow Selah Player to manage music files.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["audio", "photo"]
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "72220d9c-cf3f-43aa-9f34-492dfccce201"
      }
    }
  }
}
