{
  "name": "selah-music-player",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-media-library": "~58.0.14",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1",
    "react-native-youtube-iframe": "^2.4.0"
  },
  "scripts": {
    "start": "expo start --go -c",
    "tunnel": "expo start --tunnel --go -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.1"
  },
  "jest": {
    "projects": [
      {
        "displayName": "iphone",
        "preset": "jest-expo/ios",
        "setupFiles": [
          "<rootDir>/test/setup.js"
        ],
        "testMatch": [
          "<rootDir>/test/**/*.test.js"
        ]
      },
      {
        "displayName": "android",
        "preset": "jest-expo/android",
        "setupFiles": [
          "<rootDir>/test/setup.js"
        ],
        "testMatch": [
          "<rootDir>/test/**/*.test.js"
        ]
      }
    ]
  }
}
